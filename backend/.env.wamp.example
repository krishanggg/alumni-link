APP_NAME=AlumniLink
APP_ENV=production
APP_STAGE=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://alumnilink.local
FRONTEND_URL=http://alumnilink.local
CORS_ALLOWED_ORIGINS=http://alumnilink.local,http://alumnilink.local:5173
# Allow the local Expo web preview on Metro's default port, including when
# viewed from another device on the same private network.
CORS_ALLOWED_ORIGIN_PATTERNS="#^http://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+):8081$#"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Keep a real client install empty except for the initial Super Admin.
RUN_DEVELOPMENT_SEEDERS=false
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# WAMP MySQL. Change the port, username, or password to match the local service.
# 3306 is common, but WAMP installations may use another valid TCP port.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ENGINE=InnoDB
DB_DATABASE=alumnilink
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=alumnilink.local
SANCTUM_STATEFUL_DOMAINS=alumnilink.local,alumnilink.local:5173

# Core client delivery uses HTTP polling for feedback updates. Reverb is optional.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail is logged locally until the client configures Resend or SMTP.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@alumnilink.local"
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_DISK=local

# Leave blank to let the application locate the WAMP MySQL client tools, or set
# absolute paths when WAMP is installed outside its usual locations.
MYSQLDUMP_PATH=
MYSQL_PATH=

# Required before the first seed. Use a strong private password.
SUPER_ADMIN_NAME="System Admin"
SUPER_ADMIN_EMAIL=admin@alumnilink.local
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=

# Optional Reverb server values. See the WAMP guide before enabling them.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=alumnilink.local
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# REVERB_ALLOWED_ORIGINS=http://alumnilink.local
