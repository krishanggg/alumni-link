# Generated by AlumniLink setup.bat from this template.
# __ALUMNILINK_ROOT__ is replaced with the absolute client-delivery folder path.
# __PHP_VERSION__ is replaced with a WAMP PHP 8.4+ installation used through FCGI.

<VirtualHost *:80>
    ServerName alumnilink.local
    DocumentRoot "__ALUMNILINK_ROOT__/backend/public"

    <Directory "__ALUMNILINK_ROOT__/backend/public">
        AllowOverride All
        Options FollowSymLinks
        Require all granted

        <IfModule fcgid_module>
            <Files ~ "\.php$">
                Options +ExecCGI
                AddHandler fcgid-script .php
                FcgidWrapper "${PHPROOT}__PHP_VERSION__/php-cgi.exe" .php
            </Files>
        </IfModule>
    </Directory>

    <IfModule fcgid_module>
        Define FCGIPHPVERSION "__PHP_VERSION__"
        FcgidInitialEnv PHPRC "${PHPROOT}${FCGIPHPVERSION}/php.ini"
        # Laravel requests can overlap with the queue, scheduler, and health
        # checks. WAMP's small default per-class pool otherwise rejects PHP
        # requests under modest local concurrency.
        FcgidMaxProcessesPerClass 20
    </IfModule>

    # Keep the document root narrow: application source, .env, vendor,
    # private backups, and the rest of backend remain outside this directory.
    <Directory "__ALUMNILINK_ROOT__/backend">
        Require all denied
    </Directory>

    DirectoryIndex index.php index.html
    ErrorLog "__ALUMNILINK_ROOT__/apache/apache-error.log"
    CustomLog "__ALUMNILINK_ROOT__/apache/apache-access.log" common
</VirtualHost>
